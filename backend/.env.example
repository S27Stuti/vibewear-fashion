PORT=5000
NODE_ENV=production

# Database Configuration (Provide either DATABASE_URL or individual DB_* variables)
# Option A: Full Connection String (Standard on Render / Railway / Aiven / TiDB)
# DATABASE_URL=mysql://user:password@host:port/dbname

# Option B: Individual Variables
DB_NAME=vibewear
DB_USER=root
DB_PASSWORD=your_password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SSL=true

# Authentication & Security
JWT_SECRET=generate_a_random_secure_jwt_secret_here
JWT_EXPIRE=30d

# Frontend Client URL (e.g. https://vibewear.vercel.app)
CLIENT_URL=https://your-frontend-domain.vercel.app
